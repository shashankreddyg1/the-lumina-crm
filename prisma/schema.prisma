generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  contacts  Contact[]
  deals     Deal[]
  calls     Call[]
  createdAt DateTime  @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  title     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals     Deal[]
  calls     Call[]
  createdAt DateTime @default(now())

  @@index([userId])
}

enum DealStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model Deal {
  id        String    @id @default(cuid())
  title     String
  value     Float
  stage     DealStage @default(DISCOVERY)
  contactId String?
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

enum CallStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  ANALYZED
  FAILED
}

model Call {
  id          String       @id @default(cuid())
  title       String
  audioUrl    String?
  transcript  String?      @db.Text
  status      CallStatus   @default(UPLOADED)
  durationSec Int?
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionItems ActionItem[]
  createdAt   DateTime     @default(now())

  @@index([userId])
}

model ActionItem {
  id        String    @id @default(cuid())
  text      String
  owner     String?
  dueDate   DateTime?
  done      Boolean   @default(false)
  callId    String
  call      Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([callId])
}
